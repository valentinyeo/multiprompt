{
  "name": "multiprompt-account",
  "main": "worker.js",
  "compatibility_date": "2026-10-09",
  "account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "account.example.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "multiprompt-account",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "ACCESS_TEAM": "YOUR_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "YOUR_ACCESS_AUDIENCE",
    "ACCOUNT_EMAIL": "owner@example.com"
  },
  "observability": {
    "enabled": false
  }
}
