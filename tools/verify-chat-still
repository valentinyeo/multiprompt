#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/multiprompt-chat-still-z3-4.13.4.0"
if [ ! -f "$cache/ready" ]; then
  python3 -m venv "$cache"
  "$cache/bin/python" -m pip install --disable-pip-version-check z3-solver==4.13.4.0
  touch "$cache/ready"
fi
exec "$cache/bin/python" "$root/tools/chat-still/verify.py" "$@"
